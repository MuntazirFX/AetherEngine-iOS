name: Cleanup All Releases and Tags

on:
  workflow_dispatch:
    inputs:
      confirm:
        description: 'Type DELETE to confirm'
        required: true
        type: string

permissions:
  contents: write

jobs:
  cleanup:
    name: Delete All Releases + Tags
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Check confirmation
        run: |
          if [ "${{ github.event.inputs.confirm }}" != "DELETE" ]; then
            echo "❌ Confirmation failed. You must type DELETE to proceed."
            exit 1
          fi
          echo "✅ Confirmation received."

      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Delete all releases
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          echo "=== Fetching releases ==="
          gh release list --repo ${{ github.repository }} --limit 500 --json tagName --jq '.[].tagName' > /tmp/releases.txt || true
          if [ ! -s /tmp/releases.txt ]; then
            echo "No releases found."
          else
            echo "Found $(wc -l < /tmp/releases.txt) releases"
            while IFS= read -r tag; do
              if [ -n "$tag" ]; then
                echo "→ Deleting release: $tag"
                gh release delete "$tag" --repo ${{ github.repository }} --yes --cleanup-tag || echo "  (skipped)"
              fi
            done < /tmp/releases.txt
          fi

      - name: Delete all tags
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          echo "=== Fetching tags ==="
          git ls-remote --tags origin | awk '{print $2}' | sed 's|refs/tags/||' | grep -v '\^{}' > /tmp/tags.txt || true
          if [ ! -s /tmp/tags.txt ]; then
            echo "No tags found."
          else
            echo "Found $(wc -l < /tmp/tags.txt) tags:"
            cat /tmp/tags.txt
            echo ""
            while IFS= read -r tag; do
              if [ -n "$tag" ]; then
                echo "→ Deleting tag: $tag"
                git push origin ":refs/tags/$tag" 2>/dev/null || echo "  (skipped)"
              fi
            done < /tmp/tags.txt
          fi

      - name: Summary
        if: always()
        run: |
          echo "### Cleanup Complete" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "Releases and tags cleaned." >> $GITHUB_STEP_SUMMARY
